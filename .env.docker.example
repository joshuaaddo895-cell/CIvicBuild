# Copy to .env when using docker compose for a fully local stack.
# docker compose overrides NEON_DATABASE_URL and REDIS_URL to point at local containers.

# Local Postgres (docker compose service: postgres)
NEON_DATABASE_URL=postgresql://civicbuild:civicbuild@localhost:5432/civicbuild

# Local Redis (docker compose service: redis)
REDIS_URL=redis://localhost:6379

# Required — fill in your own values
RESEND_API_KEY=
JWT_SECRET=
GOOGLE_WEB_CLIENT_ID=

# Paystack (test mode)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://civicbuild-production.up.railway.app/api/payments/paystack/callback
PAYSTACK_WEBHOOK_URL=https://civicbuild-production.up.railway.app/api/payments/webhook

SERVER_PORT=8081
