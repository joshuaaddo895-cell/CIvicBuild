{
  "info": {
    "_postman_id": "civicbuild-auth-api",
    "name": "CivicBuild API",
    "description": "CivicBuild backend API (auth + orders/payments).\n\n**Production:** `https://civicbuild-production.up.railway.app`\n**Local:** `http://localhost:8081`\n\nSwitch `baseUrl` between `{{baseUrl}}` (Railway) and `{{baseUrlLocal}}` (Docker/local).\n\n**Auth flow:**\n1. Register → 201\n2. Login → `accessToken` + `refreshToken` (auto-saved)\n3. Protected routes: `Authorization: Bearer {{accessToken}}`\n4. Checkout → Paystack `authorizationUrl`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://civicbuild-production.up.railway.app" },
    { "key": "baseUrlLocal", "value": "http://localhost:8081" },
    { "key": "email", "value": "user@example.com" },
    { "key": "password", "value": "Secret123" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "googleIdToken", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paystackReference", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "App Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Public liveness check. Returns `{ success, data: { status: \"UP\" } }`."
          },
          "response": []
        },
        {
          "name": "Actuator Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "Spring Boot Actuator health endpoint (also public)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Success true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Role defaults to CUSTOMER', () => pm.expect(pm.response.json().data.role).to.eql('CUSTOMER'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Create a new account. Rate limited: 5 attempts / 15 min per IP+email."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}",
                  "pm.test('Has tokens', () => {",
                  "  pm.expect(json.data.accessToken).to.be.a('string');",
                  "  pm.expect(json.data.refreshToken).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Google Sign-In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/google"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/forgot-password"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NewSecret456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password"
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"NewSecret456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/change-password",
            "description": "Logged-in user changes password. Revokes all refresh tokens (other devices). Current access token remains valid until expiry."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/users/me"
          },
          "response": []
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"profilePictureUrl\": \"https://cdn.example.com/avatar.jpg\"\n}"
            },
            "url": "{{baseUrl}}/api/users/me",
            "description": "Update fullName and profilePictureUrl. Email is read-only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/account",
            "description": "Permanently deletes the authenticated user and cascades related data."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('orderId', json.data.orderId);",
                  "  pm.collectionVariables.set('paystackReference', json.data.paystackReference);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productName\": \"Cement\",\n      \"supplierName\": \"BuildCo\",\n      \"unitPrice\": 100.00,\n      \"quantity\": 2,\n      \"unit\": \"bags\"\n    }\n  ],\n  \"delivery\": {\n    \"address\": \"12 Market Road\",\n    \"city\": \"Accra\",\n    \"region\": \"Greater Accra\",\n    \"phoneNumber\": \"+233201234567\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/orders/checkout",
            "description": "Creates order (PENDING), initializes Paystack, returns `authorizationUrl` for WebView. Requires JWT. Totals recomputed server-side."
          },
          "response": []
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/orders/{{orderId}}/verify",
            "description": "Fallback: calls Paystack Verify API for stored reference. Webhook is primary source of truth."
          },
          "response": []
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/orders/{{orderId}}"
          },
          "response": []
        },
        {
          "name": "List My Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/orders"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payments (reference)",
      "item": [
        {
          "name": "Paystack Callback (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payments/paystack/callback",
            "description": "Browser redirect after Paystack checkout. NOT payment confirmation — status updates via webhook or /verify only."
          },
          "response": []
        },
        {
          "name": "Paystack Webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-paystack-signature", "value": "<HMAC-SHA512 of raw body>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"charge.success\",\n  \"data\": {\n    \"id\": 4099797291,\n    \"reference\": \"{{paystackReference}}\",\n    \"amount\": 20000,\n    \"currency\": \"GHS\",\n    \"status\": \"success\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/payments/webhook",
            "description": "Called by Paystack only. Signature must be computed from raw body with PAYSTACK_SECRET_KEY. Configure webhook URL in Paystack dashboard:\n`https://civicbuild-production.up.railway.app/api/payments/webhook`"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Register - Duplicate Email (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duplicate\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "response": []
        },
        {
          "name": "Login - Wrong Password (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"WrongPass1\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Register - Validation Error (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "response": []
        },
        {
          "name": "Protected Route - No Token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders",
            "description": "Protected route without Bearer token returns 401."
          },
          "response": []
        }
      ]
    }
  ]
}
