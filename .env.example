# CivicBuild environment template. Copy to .env and fill in real values.
# The real .env is git-ignored and must never be committed.

# Neon Postgres connection URL (postgresql://user:pass@host/db?sslmode=require...)
NEON_DATABASE_URL=

# Upstash Redis TLS URL (rediss://default:password@host:port)
REDIS_URL=

# Resend API key (re_...)
RESEND_API_KEY=

# JWT HS256 signing secret. Must be at least 32 bytes.
# Generate e.g.: openssl rand -base64 64
JWT_SECRET=

# Backend HTTP port (frontend typically uses 8080)
SERVER_PORT=8081

# Google OAuth — web client ID is required for backend ID-token verification.
# The client secret is NOT used for ID-token verification (backend-only if needed later).
GOOGLE_WEB_CLIENT_ID=
# GOOGLE_WEB_CLIENT_SECRET=

# Paystack (test mode)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Optional overrides (defaults shown in application.yml):
# JWT_ACCESS_TTL=PT15M
# JWT_REFRESH_TTL=P7D
# PASSWORD_RESET_TTL=PT30M
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_ATTEMPTS=5
# RATE_LIMIT_WINDOW=PT15M
# EMAIL_FROM=CivicBuild <onboarding@resend.dev>
# PASSWORD_RESET_BASE_URL=http://localhost:8081/reset-password
